    {
      "id": "node-merge",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "append",
        "options": {}
      }
    },
    {
      "id": "node-3",
      "name": "Build Competitor Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "jsCode": "// Builds the competitor queue. Ad Library access now goes through a Relevance AI\n// tool that wraps Apify on Relevance's platform key -- no Apify token involved.\nconst MAX_ADS = 50;\n\nconst allItems = $input.all();\nconst existingIds = new Set();\nconst competitors = [];\n\nfor (const item of allItems) {\n  const f = item.json.fields || item.json;\n  // Airtable existing ads have Ad Archive ID\n  if (f['Ad Archive ID']) {\n    existingIds.add(String(f['Ad Archive ID']));\n    continue;\n  }\n  // Competitors have Name + Facebook Page ID\n  if (f['Name'] && f['Facebook Page ID']) {\n    competitors.push({\n      name: f['Name'],\n      pageId: String(f['Facebook Page ID']),\n      pageUrl: f['Facebook Page URL'] || f['Page URL'] || '',\n      tier: f['Niche Tier'] || 'Direct'\n    });\n  }\n}\n\nif (competitors.length === 0) return [];\n\nreturn competitors.map(comp => ({\n  json: {\n    ...comp,\n    maxAds: MAX_ADS,\n    existingIds: [...existingIds]\n  }\n}));"
      }
    },
    {
      "id": "node-loop",
      "name": "Loop Competitors",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        980,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-4",
      "name": "Scrape Ad Library",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api-{{ $env.RELEVANCE_REGION || 'f1db6c' }}.stack.tryrelevance.com/latest/studios/{{ $env.RELEVANCE_ADLIB_STUDIO_ID }}/trigger",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.RELEVANCE_PROJECT }}:{{ $env.RELEVANCE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $env.RELEVANCE_PROJECT, params: Object.assign({ operation: 'scrape_ads', limit: $json.maxAds }, $json.pageUrl ? { page_url: $json.pageUrl } : { page_id: $json.pageId }) }) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "node-5",
      "name": "Fetch Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        200
      ],
      "parameters": {
        "jsCode": "// The Relevance tool returns already-normalised records, so there is no dataset\n// to fetch. Unwrap the response and surface any scraper-reported errors.\nconst res = $input.first().json || {};\nconst out = res.output || res;\nconst errs = out.actor_errors || [];\nif (errs.length) {\n  console.log('Ad Library scraper reported: ' + errs.join('; '));\n}\nconst records = out.records || [];\nreturn [{ json: { records, count: records.length, actor_errors: errs } }];"
      }
    },
    {
      "id": "node-6",
      "name": "Process and Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        200
      ],
      "parameters": {
        "jsCode": "// Records arrive pre-normalised from the Relevance Ad Library tool, so there is a\n// single field mapping here regardless of which upstream scraper ran.\nconst competitor = $('Loop Competitors').first().json;\nconst existingIds = new Set((competitor.existingIds || []).map(String));\nconst records = $input.first().json.records || [];\n\nconst today = new Date().toISOString().split('T')[0];\nconst rows = [];\n\nrecords.forEach((r, i) => {\n  const id = r.ad_archive_id ? String(r.ad_archive_id) : null;\n  if (!id || existingIds.has(id)) return;\n\n  const body = r.body_text || (r.cards && r.cards[0] ? r.cards[0].body : '') || '';\n  const hook = body.split(/[.\\n]/)[0] || '';\n\n  rows.push({\n    json: {\n      'Ad Archive ID': id,\n      'Competitor': competitor.name,\n      'Page Name': r.page_name || competitor.name,\n      'Ad Library URL': r.ad_library_url || ('https://www.facebook.com/ads/library/?id=' + id),\n      'Status': 'Active',\n      'Ad Active Status': r.is_active ? 'Active' : 'Inactive',\n      'Start Date': r.start_date || null,\n      'End Date': r.end_date || null,\n      'Display Format': r.display_format || null,\n      'Body Text': body,\n      'Title': r.title || (r.cards && r.cards[0] ? r.cards[0].title : null),\n      'CTA Type': r.cta_type || null,\n      'CTA Text': r.cta_text || null,\n      'Link URL': r.link_url || null,\n      'Video URL': r.video_url || null,\n      'Image URL': r.image_url || null,\n      'Publisher Platforms': r.publisher_platforms || [],\n      'Impressions Rank': r.impressions_rank || (i + 1),\n      'Word Count': body ? body.trim().split(/\\s+/).length : 0,\n      'Hook Copy': hook,\n      'Scrape Date': today,\n      'Scrape Batch ID': competitor.name + '-' + today,\n      'Is Analyzed': false\n    }\n  });\n});\n\nreturn rows;"
      }
    },
    {
