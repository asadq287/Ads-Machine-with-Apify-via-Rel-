      ],
      "parameters": {
        "operation": "list",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "YOUR_SWIPE_FILE_TABLE_ID",
          "mode": "id"
        },
        "options": {
          "fields": [
            "Ad Archive ID"
